# Backend: разрешенные источники CORS через запятую
CORS_ORIGINS=*
# Backend: папка собранного фронтенда (по умолчанию ../frontend/dist)
# STATIC_DIR=/app/static

# Frontend (dev): куда vite проксирует /api
API_PROXY_TARGET=http://localhost:8000
# Frontend: адрес API, если он на другом домене (по умолчанию тот же origin)
# VITE_API_URL=https://api.example.com

# --- Защита публичного сервера (backend) ---
# Пароль на сайт и API (HTTP Basic). Пусто — доступ открыт всем
ACCESS_USER=lab
ACCESS_PASSWORD=
# Размеры: один файл, весь запрос, файлов в одном запросе
MAX_UPLOAD_MB=300
MAX_REQUEST_MB=2048
MAX_FILES_PER_REQUEST=200
# Запросов в минуту с одного адреса; одновременная тяжёлая обработка с адреса и всего
RATE_LIMIT_PER_MIN=1200
HEAVY_PER_CLIENT=4
HEAVY_TOTAL=8
# Память под загруженные кадры, МБ
FRAME_STORE_MB=1500
