# Backend: разрешенные источники CORS через запятую
CORS_ORIGINS=*
# Backend: папка собранного фронтенда (по умолчанию ../frontend/dist)
# STATIC_DIR=/app/static

# Frontend (dev): куда vite проксирует /api
API_PROXY_TARGET=http://localhost:8000
# Frontend: адрес API, если он на другом домене (по умолчанию тот же origin)
# VITE_API_URL=https://api.example.com
